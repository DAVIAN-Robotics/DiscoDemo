        def Material "environment_depth_proxy_material" {
            token outputs:surface.connect = <surface.outputs:surface>
            def Shader "surface" {
                uniform token info:id = "UsdPreviewSurface"

                color3f inputs:diffuseColor.connect = <../image.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 1

                token outputs:surface
            }
            def Shader "st_reader" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "image" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/wrist_background_layer2.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = <../st_reader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float outputs:a
                color3f outputs:rgb
            }
        }
}
